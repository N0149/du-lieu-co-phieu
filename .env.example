# Google Drive API key (bắt buộc để quét toàn bộ báo cáo từ Drive)
# Tạo tại: https://console.cloud.google.com/apis/credentials
# Lưu ý: Folder Drive và các file báo cáo cần được chia sẻ công khai
# (Anyone with the link → Viewer) để API key truy cập được.
GOOGLE_DRIVE_API_KEY=

# Folder ID chứa các báo cáo trên Google Drive
GOOGLE_DRIVE_FOLDER_ID=1eI8C_uDJlKDvNbzF9YOOr6QNCUIdw7o8

# Google Gemini API key (Dùng cho Trợ lý AI Hỏi Đáp Chuyên Sâu + Google Search)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Upstash Redis (Dùng để kiểm soát Rate Limit hỏi đáp AI: 5 lượt/ngày cho khách, 50 lượt/ngày cho thành viên)
# Tạo database Redis Serverless miễn phí tại: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
